{
  "name": "ثانوية الذرى الذكية للمتميزين",
  "short_name": "الذرى",
  "description": "منصة طلابية متكاملة لثانوية الذرى الذكية للمتميزين — كربلاء المقدسة.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#f0ece0",
  "theme_color": "#f0ece0",
  "lang": "ar",
  "dir": "rtl",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "categories": [
    "education",
    "productivity"
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/ai",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "الجدول",
      "short_name": "الجدول",
      "url": "/schedule",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "الواجبات",
      "short_name": "الواجبات",
      "url": "/homework",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "الكروبات",
      "short_name": "الكروبات",
      "url": "/groups",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "التبليغات",
      "short_name": "التبليغات",
      "url": "/announcements",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
